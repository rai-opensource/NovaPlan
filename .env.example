# Copy only the block for the role you are launching. PORT is role-specific.

# Planner LLMs
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6

# Optional Veo backend
GOOGLE_CLOUD_PROJECT=
VEO3_MODEL=veo-3.1-generate-001
VEO_OPERATION_TIMEOUT_SECONDS=1800
VEO_REQUEST_TIMEOUT_SECONDS=120
VEO_DOWNLOAD_TIMEOUT_SECONDS=300

# Workstation -> remote services
NOVAPLAN_VIDEO_SERVER_URL=http://127.0.0.1:7000
NOVAPLAN_OBJECT_FLOW_SERVER_URL=http://127.0.0.1:7001
NOVAPLAN_HAND_FLOW_SERVER_URL=http://127.0.0.1:8080/predict

# Video-generation host
PORT=7000
COMFYUI_HOST=http://127.0.0.1
# Omit COMFYUI_DIR to use <repo>/.runtime/comfyui.
# COMFYUI_DIR=/absolute/path/to/comfyui
COMFYUI_WORKER_START_PORT=8188
COMFYUI_NUM_WORKERS=8

# Object-flow host
PORT=7001
COMFYUI_HOST=http://127.0.0.1
COMFYUI_START_PORT=8187
COMFYUI_MASTER_PORT=8187
COMFYUI_NUM_WORKERS=1
# Omit COMFYUI_DIR and its derived input/output/result paths to use the repo-local runtime.
# COMFYUI_DIR=/absolute/path/to/comfyui
# NOVAPLAN_DEMO_ROOT=/absolute/path/to/comfyui/custom_nodes/novaplan/demo_data
FLOW_SWITCH_THETA_DEG=45
MODEL_PINNING_ENABLED=1
PREFER_DIRECT_OUTPUT_READ=1
SAVE_DEBUG_WORKFLOWS=0
SAVE_RESULT_VIDEOS=0

# Hand-flow service (HaMeR backend)
PORT=8080
HAMER_DIR=remote_hand_flow/.external/hamer
HOST=127.0.0.1
HAMER_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu117
HAMER_BODY_DETECTOR=vitdet
PYOPENGL_PLATFORM=egl
MANO_RIGHT_SOURCE=
DOWNLOAD_HAMER_MODELS=1
REQUIRE_MANO=1

# Recovery generates and ranks both Wan and Veo candidates by default.
NOVAPLAN_RECOVERY_VIDEO_BACKEND=both

# Local output root
NOVAPLAN_RESULTS_DIR=
